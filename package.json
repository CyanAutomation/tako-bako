{
  "name": "tako-bako",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^26.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sim": "node --import tsx scripts/dev-simulator.ts",
    "build": "tsc -p tsconfig.app.json && tsc -p tsconfig.api.json && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "node scripts/run-tests.ts",
    "test:sim": "node --import tsx --test tests/simulator/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:sim": "playwright test --config playwright.sim.config.ts",
    "test:coverage": "node scripts/run-tests.ts --coverage",
    "fallow:health": "fallow health --report-only",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "check:external-links": "node scripts/check-external-links.ts",
    "check": "npm run lint && npm run test && npm run check:docs && npm run build",
    "check:docs": "node scripts/check-readme.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vercel/node": "^30.0.0",
    "eslint": "^10.15.0",
    "fallow": "3.49.0",
    "linkedom": "0.18.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "path-to-regexp": "^6.3.0",
    "undici": "^6.24.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0"
  }
}
